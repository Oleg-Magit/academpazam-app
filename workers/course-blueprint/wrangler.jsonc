{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "academpazam-course-blueprint",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "87423102",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": { "ALLOWED_ORIGIN": "https://oleg-magit.github.io" }
}
