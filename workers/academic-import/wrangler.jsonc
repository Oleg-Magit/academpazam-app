{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "academpazam-academic-import",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "87423101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "ALLOWED_ORIGIN": "http://localhost:5173"
  }
}
